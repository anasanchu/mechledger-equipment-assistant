# Optional MinerU service access
HF_TOKEN=
MINERU_API_URL=https://abhiswork-ikb-mineru.hf.space/file_parse
MINERU_TIMEOUT_SECONDS=300

# Local embeddings and optional local response generation via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMENSION=768
OLLAMA_CHAT_MODEL=qwen2.5:3b

# Optional Groq hosted response generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Qdrant; without these settings the model-scoped local JSON index is used
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_COLLECTION_NAME=mechledger-nomic-embed-text

MAX_UPLOAD_MB=50
